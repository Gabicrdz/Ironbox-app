datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id           String   @id @default(uuid())
  username     String   @unique
  password     String
  nombre       String
  apellido     String
  edad         Int
  horarioClase String
  rol          String   @default("ATLETA")
  fotoUrl      String?
  categoria    String   @default("RX")
  scores       Score[]
  rms          Rm[]
}

model Wod {
  id          String   @id @default(uuid())
  fecha       DateTime @unique @db.Date
  tipo        String
  descripcion String   @db.Text
  goal        String   @db.Text
  scores      Score[]
}

model Score {
  id            String  @id @default(uuid())
  usuarioId     String
  wodId         String
  tiempoPuntaje String
  categoria     String
  createdAt     DateTime @default(now())
  usuario       Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  wod           Wod     @relation(fields: [wodId], references: [id], onDelete: Cascade)
}

model Rm {
  id        String   @id @default(uuid())
  usuarioId String
  ejercicio String
  peso      Float
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}